# Copy to .env before `docker compose up`. These values run a private dev stack.
# Change every secret before the server is reachable from the internet.

# Browser origin of the website. Stripe returns here. Muse instructions print this URL.
# Host-network deploy: website on 8080, API bound to 127.0.0.1:8787.
# Optional bridge compose (docker-compose.bridge.yml) publishes the website on 8471
# and sets PUBLIC_URL itself.
PUBLIC_URL=http://127.0.0.1:8080

# API
API_HOST=127.0.0.1
API_PORT=8787
# At least 16 characters. The server warns when this still contains "change-me".
JWT_SECRET=dev-only-change-me-please-32chars
JWT_TTL_DAYS=30
# auto | true | false. Defaults to true when PUBLIC_URL starts with https://
COOKIE_SECURE=false

# Postgres. DATABASE_URL inside compose is rewritten to host "postgres".
# If you run the API on the host, point this at 127.0.0.1 instead.
POSTGRES_USER=muse
POSTGRES_PASSWORD=muse_dev_password
POSTGRES_DB=muse
DATABASE_URL=postgres://muse:muse_dev_password@127.0.0.1:5432/muse

# Trial and price. The server does not call a model, so the price is storage and access only.
TRIAL_DAYS=7
PRICE_CENTS=500
CURRENCY=usd
MAX_UPLOAD_BYTES=83886080

# Object storage. s3 talks to the bundled Silo service (S3-compatible; compose
# service name "minio"). fs stores blobs on STORAGE_DIR instead.
STORAGE_DRIVER=s3
STORAGE_DIR=/data
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=muse-audio
S3_ACCESS_KEY=museadmin
S3_SECRET_KEY=museadmin-secret
S3_FORCE_PATH_STYLE=true

# Cloudflare R2 (server only). Used when STORAGE_DRIVER=r2.
# Leave blank in local dev. Do not put these in the Android app or the website.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# Supabase reads. Default off. See docs/platform-r2-supabase.md.
# Do not set a secret key in Android or the browser.
SUPABASE_INTEGRATION=disabled
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_READ_MODE=user_jwt
SUPABASE_READ_ALLOWLIST=

# Billing. Leave the Stripe keys empty to use the local stub (no charges).
# auto uses Stripe when both the secret key and price id are set, otherwise stub.
BILLING_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Shown by POST /api/v1/auth/forgot. This server does not send reset email.
SUPPORT_EMAIL=
FREE_QUOTA_BYTES=2147483648
PAID_QUOTA_BYTES=21474836480
